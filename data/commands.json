      "options": [
        { "flag": "-O", "description": "指定输出文件名" },
        { "flag": "-c", "description": "断点续传" },
        { "flag": "-r", "description": "递归下载" },
        { "flag": "-q", "description": "安静模式" }
      ],
      "examples": [
        { "cmd": "wget https://example.com/file.zip", "desc": "下载文件" },
