        { "cmd": "tar -xvf backup.tar", "desc": "解压 tar 包" },
        { "cmd": "tar -czvf archive.tar.gz dir/", "desc": "创建 gzip 压缩归档" },
        { "cmd": "tar -xzvf archive.tar.gz", "desc": "解压 gzip 归档" },
        { "cmd": "tar -tjf archive.tar.bz2", "desc": "查看 bzip2 归档内容" }
      ]
    },
