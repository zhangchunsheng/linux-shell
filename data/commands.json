        { "flag": "-y", "description": "并排显示差异" }
      ],
      "examples": [
        { "cmd": "diff file1.txt file2.txt", "desc": "比较两个文件" },
        { "cmd": "diff -ru dir1 dir2", "desc": "递归比较目录" },
        { "cmd": "diff -y file1 file2", "desc": "并排比较" }
      ]
    },
    {
      "name": "scp",
      "category": "网络",
      "description": "安全的文件远程复制 (secure copy)",
      "syntax": "scp [选项] 源文件 目标",
      "options": [
