        { "flag": "-p", "description": "执行前询问" }
      ],
      "examples": [
        { "cmd": "find . -name \"*.log\" | xargs rm", "desc": "查找并删除所有 log 文件" },
        { "cmd": "echo \"file1 file2\" | xargs -n1 echo", "desc": "逐行输出" },
        { "cmd": "cat files.txt | xargs -I {} cp {} /backup/", "desc": "批量复制文件" }
      ]
    },
